{
  "name": "codex-agent-tools",
  "version": "0.1.0-alpha.1",
  "description": "Codex-facing external LLM review and delegation tools",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/operations.md",
    "docs/migration-from-codex-cc-tools.md",
    "docs/release/checklist.md",
    "docs/smoke/kimi.md",
    "docs/smoke/pi-gemini.md",
    "docs/smoke/ark.md",
    "docs/smoke/evidence"
  ],
  "bin": {
    "codex-agent-tools": "dist/cli.js",
    "codex-external-agents-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "npm run build:library && npm run build:plugin",
    "build:library": "tsup",
    "build:plugin": "tsup --config tsup.plugin.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:release": "npm run build && node scripts/release-smoke.mjs",
    "smoke:kimi": "npm run build && node scripts/real-kimi-smoke.mjs",
    "smoke:pi": "npm run build && node scripts/real-pi-smoke.mjs",
    "smoke:ark": "npm run build && node scripts/real-ark-smoke.mjs",
    "acceptance:local": "npm run build && node scripts/local-acceptance.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "8.5.1",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
