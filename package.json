{
  "name": "codex-agent-tools",
  "version": "0.1.1-beta.1",
  "description": "Codex-facing external LLM review and delegation tools",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yiyuiii/codex-agent-tools.git"
  },
  "homepage": "https://github.com/Yiyuiii/codex-agent-tools#readme",
  "bugs": {
    "url": "https://github.com/Yiyuiii/codex-agent-tools/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "config": {
    "codexCliVersion": "0.146.0"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/cli.js",
    "dist/mcp.js",
    "README.md",
    "LICENSE",
    "docs/operations.md",
    "docs/migration-from-codex-cc-tools.md",
    ".agents/plugins/marketplace.json",
    "plugins/codex-external-agents/.codex-plugin/plugin.json",
    "plugins/codex-external-agents/.mcp.json",
    "plugins/codex-external-agents/runtime/codex-external-agents-mcp.mjs",
    "plugins/codex-external-agents/native/win32-x64/codex-agent-job-helper.exe",
    "plugins/codex-external-agents/native/win32-x64/codex-agent-job-helper.exe.sha256",
    "docs/smoke/evidence/capabilities.json",
    "docs/smoke/evidence/2026-07-25T16-10-32.796Z-ark-agent-deepseek-v4-flash-delegate-ark.json",
    "docs/smoke/evidence/batches/2026-07-28T01-52-35.087Z-cb1be2f4-62ab-4af1-b3f1-9f36cba83678/cases/2026-07-28T02-04-08.782Z-ark-agent-plan-delegate-ark.json",
    "docs/smoke/evidence/batches/2026-07-28T01-52-35.087Z-cb1be2f4-62ab-4af1-b3f1-9f36cba83678/cases/2026-07-28T02-04-38.189Z-ark-agent-deepseek-v4-flash-review-ark.json",
    "docs/smoke/evidence/batches/2026-07-28T01-52-35.087Z-cb1be2f4-62ab-4af1-b3f1-9f36cba83678/manifest.json",
    "docs/smoke/evidence/batches/2026-07-28T14-33-04.239Z-3b17ac96-4bb1-4a63-9f37-6caf35ad715c/cases/2026-07-28T14-37-11.799Z-ark-coding-plan-delegate-ark.json",
    "docs/smoke/evidence/batches/2026-07-28T14-33-04.239Z-3b17ac96-4bb1-4a63-9f37-6caf35ad715c/cases/2026-07-28T14-37-32.617Z-ark-coding-plan-review-ark.json",
    "docs/smoke/evidence/batches/2026-07-28T14-33-04.239Z-3b17ac96-4bb1-4a63-9f37-6caf35ad715c/cases/2026-07-28T14-38-02.020Z-kimi-k3-review.json",
    "docs/smoke/evidence/batches/2026-07-28T14-33-04.239Z-3b17ac96-4bb1-4a63-9f37-6caf35ad715c/cases/2026-07-28T14-38-33.375Z-kimi-k3-delegate.json",
    "docs/smoke/evidence/batches/2026-07-28T14-33-04.239Z-3b17ac96-4bb1-4a63-9f37-6caf35ad715c/cases/2026-07-28T14-38-53.652Z-ark-agent-plan-review-ark.json",
    "docs/smoke/evidence/batches/2026-07-28T14-33-04.239Z-3b17ac96-4bb1-4a63-9f37-6caf35ad715c/manifest.json"
  ],
  "bin": {
    "codex-agent-tools": "dist/cli.js",
    "codex-external-agents-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "npm run build:library && npm run build:plugin",
    "build:library": "tsup",
    "build:plugin": "tsup --config tsup.plugin.config.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:deterministic": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "smoke:release": "npm run build && npm run smoke:release:built",
    "smoke:release:built": "node scripts/release-smoke.mjs",
    "gate:offline": "npm run build && npm run typecheck && npm run test:deterministic && npm run smoke:release:built",
    "smoke:kimi": "npm run build && node scripts/real-kimi-smoke.mjs",
    "smoke:ark": "npm run build && node scripts/real-ark-smoke.mjs",
    "acceptance:npm-package": "npm run build && node scripts/npm-package-acceptance.mjs",
    "acceptance:plugin:isolated": "npm run build && npm run acceptance:plugin:isolated:built",
    "acceptance:plugin:isolated:built": "node scripts/plugin-isolated-acceptance.mjs",
    "qualify:gates": "tsx scripts/gate-requalification.ts",
    "verify:qualification": "tsx scripts/verify-qualification.ts",
    "verify:capabilities": "tsx scripts/verify-capabilities.ts",
    "native:preflight": "node scripts/windows-native-helper.mjs preflight",
    "native:test:managed": "node scripts/windows-native-helper.mjs test-managed",
    "native:test:kernel": "node scripts/windows-native-helper.mjs test-kernel",
    "native:verify": "node scripts/windows-native-helper.mjs verify",
    "native:update-artifact": "node scripts/windows-native-helper.mjs update-artifact",
    "observer:test:managed": "node scripts/host-acceptance-observer.mjs test-managed",
    "observer:test:kernel": "node scripts/host-acceptance-observer.mjs test-kernel",
    "observer:verify": "node scripts/host-acceptance-observer.mjs verify",
    "observer:update-artifact": "node scripts/host-acceptance-observer.mjs update-artifact",
    "prepublishOnly": "npm run gate:offline"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "commonmark": "0.31.2",
    "tsup": "8.5.1",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
